        "id": "fb7b0f29daebc218",
        "type": "function",
        "z": "d27ba1192b875173",
        "name": "JSON",
        "func": "let measurement = \"manualInput\";\nlet uid = global.get('uid');\nlet currentTime = new Date();\n\nfunction addsensordata(device, value){\n    let record = {\n        \"measurement\": measurement,\n        \"timestamp\": currentTime.toISOString(),\n        \"tags\":{\n            \"UID\": uid,\n            \"device\": device,\n            \"model\": value.model,\n        },\n        \"fields\": {\n            \"fuel\": value.fuel,\n            \"amount\": parseFloat(value.amount),\n            \"start\": value.start,\n            \"end\": value.end\n        }\n    };\n    return record;\n}\n\nlet data = [];\n\ndata.push(addsensordata(\"manualInput\", msg.payload));\n\nmsg.payload = data;\n\nreturn msg;\n",

    {
        "id": "a6f9c2d5c3e8bd89",
        "type": "function",
        "z": "ab257fb0cc5ba8f5",
        "name": "JSON",
        "func": "let measurement = \"sensors\";\nlet uid = global.get('uid');\nlet currentTime = new Date();\n\nfunction addsensordata(device, value){\n    let record = {\n        \"measurement\": measurement,\n        \"timestamp\": currentTime.toISOString(),\n        \"tags\":{\n            \"UID\": uid,\n            \"device\": device,\n            \"model\": value.model,\n        },\n        \"fields\": {\n            \"tempinC\": ((parseFloat(value.tempinf)-32) * 5/9), //Inhouse Temp in °C\n            \"humidityin\": parseFloat(value.humidityin), //Inhouse relativ humidity\n            \"baromin\": (parseFloat(value.baromabsin)*33.8638), //Inhouse pressure in hPa\n            \"tempC\": ((parseFloat(value.tempf)-32) * 5/9), //Outdoor Temp in °C\n            \"humidity\": parseFloat(value.humidity), //Outdoor relativ humidity\n            \"winddir\": parseFloat(value.winddir),\n            \"windspeedkmh\": (parseFloat(value.windspeedmph)*1.609), //Windspeed km/h\n            \"hourlyrainin\": parseFloat(value.hourlyrainin),\n            \"solarradiation\": parseFloat(value.solarradiation), // Watt per m2\n            \"uv\": parseFloat(value.uv),\n        }\n    };\n    return record;\n}\n\nlet data = [];\n\ndata.push(addsensordata(\"weatherstation\", msg.payload));\n\nmsg.payload = data;\n\nreturn msg;\n",

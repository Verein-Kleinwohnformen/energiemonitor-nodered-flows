    {
        "id": "3",
        "type": "function",
        "z": "e48ca2e6e4e7cd76",
        "name": "Process File",
        "func": "let files = msg.payload\nlet dates = files.map(filename => {\n    let datePart = filename.split(\"_\")[1]\n    return new Date(datePart)\n});\n\n//Generate old Files\nlet now = Date.now()\nlet oneMonthAgo = now - 2419200000  // 4 weeks in ms\nlet oldFiles = []\nfor (let i = 0; i < msg.filePaths.length; i++) {\n    if (new Date(dates[i]) < oneMonthAgo) {\n        oldFiles.push(files[i])\n    }\n}\nmsg.oldFiles = oldFiles\n\nreturn msg",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
        "y": 640,
        "wires": [
            [
                "6"
            ]
        ]
    },

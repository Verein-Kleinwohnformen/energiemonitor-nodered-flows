    {
        "id": "a6f9c2d5c3e8bd89",
        "type": "function",
        "z": "ab257fb0cc5ba8f5",
        "name": "JSON",
        "func": "let measurement = \"sensors\";\nlet uid = global.get('uid');\nlet currentTime = new Date();\n\nfunction addsensordata(device, value){\n    let record = {\n        \"measurement\": measurement,\n        \"tags\":{\n            \"UID\": uid,\n            \"device\": device,\n            \"model\": value.model,\n        },\n        \"fields\": {\n            \"timestamp\": currentTime.toISOString(),\n            \"stationtype\": parseFloat(value.stationtype),\n            \"dateutc\": parseFloat(value.dateutc),\n            \"tempinf\": parseFloat(value.tempinf),\n            \"humidityin\": parseFloat(value.humidityin),\n            \"baromrelin\": parseFloat(value.baromrelin),\n            \"baromabsin\": parseFloat(value.baromabsin),\n            \"tempf\": parseFloat(value.tempf),\n            \"humidity\": parseFloat(value.humidity),\n            \"winddir\": parseFloat(value.winddir),\n            \"winddir_avg10m\": parseFloat(value.winddir_avg10m),\n            \"windspeedmph\": parseFloat(value.windspeedmph),\n            \"maxdailygust\": parseFloat(value.maxdailygust),\n            \"rainratein\": parseFloat(value.rainratein),\n            \"eventrainin\": parseFloat(value.eventrainin),\n            \"hourlyrainin\": parseFloat(value.hourlyrainin),\n            \"dailyrainin\": parseFloat(value.dailyrainin),\n            \"weeklyrainin\": parseFloat(value.weeklyrainin),\n            \"monthlyrainin\": parseFloat(value.monthlyrainin),\n            \"yearlyrainin\": parseFloat(value.yearlyrainin),\n            \"solarradiation\": parseFloat(value.solarradiation),\n            \"uv\": parseFloat(value.uv),\n        }\n    };\n    return record;\n}\n\nlet data = [];\n\ndata.push(addsensordata(\"weatherstation\", msg.payload));\n\nmsg.payload = data;\n\nreturn msg;\n",

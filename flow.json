    {
        "id": "6326e0fe68adb662",
        "type": "function",
        "z": "c6e1822c71f940ee",
        "name": "JSON",
        "func": "let measurement = \"sensors\";\nlet uid = global.uid;\nlet currentTime = new Date();\n\nfunction addsensordata(device, input) {\n  let record = {\n    \"measurement\": measurement,\n    \"timestamp\": currentTime.toISOString(),\n    \"tags\": {\n        \"UID\": uid,\n        \"device\": device\n    },\n    \"fields\": {\n      \"a_current\": input.a_current,\n      \"a_voltage\": input.a_voltage,\n      \"a_act_power\": input.a_act_power,\n      \"a_aprt_power\": input.a_aprt_power,\n      \"a_pf\": input.a_pf,\n      \"b_current\": input.b_current,\n      \"b_voltage\": input.b_voltage,\n      \"b_act_power\": input.b_act_power,\n      \"b_aprt_power\": input.b_aprt_power,\n      \"b_pf\": input.b_pf,\n      \"c_current\": input.c_current,\n      \"c_voltage\": input.c_voltage,\n      \"c_act_power\": input.c_act_power,\n      \"c_aprt_power\": input.c_aprt_power,\n      \"c_pf\": input.c_pf,\n      \"n_current\": input.n_current\n    }\n  };\n  return record;\n}\n\nlet data = [];\n\ndata.push(addsensordata(\"shellyEMPro\", {\n  \"a_current\": msg.payload.em0.a_current,\n  \"a_voltage\": msg.payload.em0.a_voltage,\n  \"a_act_power\": msg.payload.em0.a_act_power,\n  \"a_aprt_power\": msg.payload.em0.a_aprt_power,\n  \"a_pf\": msg.payload.em0.a_pf,\n  \"b_current\": msg.payload.em0.b_current,\n  \"b_voltage\": msg.payload.em0.b_voltage,\n  \"b_act_power\": msg.payload.em0.b_act_power,\n  \"b_aprt_power\": msg.payload.em0.b_aprt_power,\n  \"b_pf\": msg.payload.em0.b_pf,\n  \"c_current\": msg.payload.em0.c_current,\n  \"c_voltage\": msg.payload.em0.c_voltage,\n  \"c_act_power\": msg.payload.em0.c_act_power,\n  \"c_aprt_power\": msg.payload.em0.c_aprt_power,\n  \"c_pf\": msg.payload.em0.c_pf,\n  \"n_current\": msg.payload.em0.n_current\n}));\n\nmsg.payload = data;\n\nreturn msg;",

    },
    {
        "id": "f982a50a.16c1d8",
        "type": "template",
        "z": "d27ba1192b875173",
        "name": "",
        "field": "payload",
        "fieldType": "msg",
        "format": "handlebars",
        "syntax": "mustache",
        "template": "<!DOCTYPE html>\n<html>\n<head>\n    <title id=\"pageTitle\" data-en=\"Fuel Input Form\" data-de=\"Eingabeformular für Brennstoff\">Fuel Input Form</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 0;\n            background-color: #f0f0f0;\n        }\n        .red-ui-editor-text-container {\n            max-width: 600px;\n            margin: 0 auto;\n            padding: 20px;\n        }\n        .form-group {\n            margin-bottom: 1em;\n        }\n        label {\n            display: block;\n            margin-bottom: .5em;\n        }\n        input, select, button {\n            width: 100%;\n            padding: .5em;\n            font-size: 1em;\n        }\n        button {\n            background-color: #007bff;\n            color: white;\n            border: none;\n            padding: .5em 1em;\n            cursor: pointer;\n        }\n        .language-select {\n            position: absolute;\n            top: 10px;\n            right: 10px;\n        }\n        .language-select img {\n            width: 24px;\n            height: 16px;\n            cursor: pointer;\n            margin-left: 5px;\n        }\n        #unitLabel {\n            padding: .5em;\n            font-size: 1em;\n        }\n    </style>\n</head>\n<body>\n<div class=\"red-ui-editor-text-container\">\n    <h1 class=\"my-4\" id=\"formTitle\" data-en=\"Fuel Input Form\" data-de=\"Eingabeformular für Brennstoff\">Fuel Input Form</h1>\n    <form action=\"/submit\" method=\"post\" id=\"fuelForm\">\n        <div class=\"form-group\">\n            <label for=\"fuel\">\n                <span class=\"en-label\" data-en=\"Fuel:\">Fuel:</span>\n                <span class=\"de-label\" style=\"display: none;\" data-de=\"Brennstoff:\">Brennstoff:</span>\n            </label>\n            <select class=\"form-control\" id=\"fuel\" name=\"fuel\">\n                <option value=\"gas\" data-en=\"Gas\" data-de=\"Gas\">Gas</option>\n                <option value=\"oil\" data-en=\"Oil\" data-de=\"Öl\">Oil</option>\n                <option value=\"wood\" data-en=\"Wood\" data-de=\"Holz\">Wood</option>\n            </select>\n        </div>\n        <div class=\"form-group\">\n            <label for=\"amount\">\n                <span class=\"en-label\">Amount:</span>\n                <span class=\"de-label\" style=\"display: none;\">Menge:</span>\n            </label>\n            <input type=\"number\" class=\"form-control\" id=\"amount\" name=\"amount\">\n        </div>\n\n        <!-- Adding dynamic unit label based on selected fuel -->\n        <div class=\"form-group unit-group\">\n            <label for=\"unit\">\n                <span class=\"en-label\">Unit:</span>\n                <span class=\"de-label\" style=\"display: none;\">Einheit:</span>\n            </label>\n            <span id=\"unitLabel\"></span>\n        </div>\n\n        <div class=\"form-group\">\n            <label for=\"start\">\n                <span class=\"en-label\">Start Date:</span>\n                <span class=\"de-label\" style=\"display: none;\">Startdatum:</span>\n            </label>\n            <input type=\"date\" class=\"form-control\" id=\"start\" name=\"start\">\n        </div>\n        <div class=\"form-group\">\n            <label for=\"end\">\n                <span class=\"en-label\">End Date:</span>\n                <span class=\"de-label\" style=\"display: none;\">Enddatum:</span>\n            </label>\n            <input type=\"date\" class=\"form-control\" id=\"end\" name=\"end\">\n        </div>\n        <button type=\"submit\" class=\"btn btn-primary\" id=\"submitButton\">\n            <span class=\"en-label\">Submit</span>\n            <span class=\"de-label\" style=\"display: none;\">Absenden</span>\n        </button>\n    </form>\n    <div class=\"language-select\">\n        <span class=\"en-label\">\n            Language:\n        </span>\n        <span class=\"de-label\" style=\"display: none;\">\n            Sprache:\n        </span>\n        <img src=\"https://www.worldometers.info/img/flags/uk-flag.gif\" alt=\"English\" class=\"language-flag\" data-lang=\"en\">\n        <img src=\"https://www.worldometers.info/img/flags/gm-flag.gif\" alt=\"Deutsch\" class=\"language-flag\" data-lang=\"de\">\n    </div>\n</div>\n<script>\n    // Get the fuel select element\n    const fuelSelect = document.getElementById('fuel');\n    // Get the unit label element\n    const unitLabel = document.getElementById('unitLabel');\n    // Get the language select element\n    const languageFlags = document.getElementsByClassName('language-flag');\n    // Get the page title element\n    const pageTitle = document.getElementById('pageTitle');\n    // Get the form title element\n    const formTitle = document.getElementById('formTitle');\n    // Get the form element\n    const form = document.forms[0];\n    // Get the amount input element\n    const amount = document.getElementById('amount');\n    // Get the start input element\n    const start = document.getElementById('start');\n    // Get the end input element\n    const end = document.getElementById('end');\n    \n    // Function to set the unit label based on the selected fuel and language\n    function setUnitLabel(selectedFuel, selectedLanguage) {\n        if (selectedFuel === 'gas') {\n            unitLabel.textContent = selectedLanguage === 'de' ? 'Kubikmeter' : 'Cubic Meters';\n        } else if (selectedFuel === 'oil') {\n            unitLabel.textContent = selectedLanguage === 'de' ? 'Liter' : 'Liters';\n        } else if (selectedFuel === 'wood') {\n            unitLabel.textContent = selectedLanguage === 'de' ? 'Ster' : 'Cords';\n        }\n    }\n    \n    // Add event listeners to the fuel select element\n    fuelSelect.addEventListener('change', function() {\n        const selectedFuel = fuelSelect.value;\n        const selectedLanguage = getSelectedLanguage();\n        setUnitLabel(selectedFuel, selectedLanguage);\n    });\n    \n    // Add event listeners to the language flags\n    for (let i = 0; i < languageFlags.length; i++) {\n        languageFlags[i].addEventListener('click', function() {\n            const selectedLanguage = this.getAttribute('data-lang');\n            toggleLanguage(selectedLanguage);\n        });\n    }\n    \n    // Function to get the selected language\n    function getSelectedLanguage() {\n        return document.getElementsByClassName('en-label')[0].style.display !== 'none' ? 'en' : 'de';\n    }\n    \n    // Function to toggle the language\n    function toggleLanguage(selectedLanguage) {\n        const enLabels = document.getElementsByClassName('en-label');\n        const deLabels = document.getElementsByClassName('de-label');\n        for (let i = 0; i < enLabels.length; i++) {\n            if (selectedLanguage === 'de') {\n                enLabels[i].style.display = 'none';\n                deLabels[i].style.display = 'inline';\n            } else {\n                enLabels[i].style.display = 'inline';\n                deLabels[i].style.display = 'none';\n            }\n            // Set the fuel options text based on the selected language\n            const fuelOptions = fuelSelect.getElementsByTagName('option');\n            for (let j = 0; j < fuelOptions.length; j++) {\n                const option = fuelOptions[j];\n                if (selectedLanguage === 'de') {\n                    option.textContent = option.getAttribute('data-de');\n                } else {\n                    option.textContent = option.getAttribute('data-en');\n                }\n            }\n        }\n        setUnitLabel(fuelSelect.value, selectedLanguage);\n        // Set the page title based on the selected language\n        if (selectedLanguage === 'de') {\n            pageTitle.textContent = pageTitle.getAttribute('data-de');\n        } else {\n            pageTitle.textContent = pageTitle.getAttribute('data-en');\n        }\n        // Set the form title based on the selected language\n        if (selectedLanguage === 'de') {\n            formTitle.textContent = formTitle.getAttribute('data-de');\n        } else {\n            formTitle.textContent = formTitle.getAttribute('data-en');\n        }\n    }\n\n    // Add event listener to the form submit event\n    form.addEventListener('submit', function(event) {\n        // Get the selected language\n        const selectedLanguage = getSelectedLanguage();\n        // Get the selected fuel\n        const selectedFuel = fuelSelect.value;\n        // Validate the inputs\n        if (!validateInput(selectedFuel, amount.value, start.value, end.value)) {\n            // If the inputs are not valid, prevent the form from being submitted\n            event.preventDefault();\n            // Show an error message based on the selected language\n            if (selectedLanguage === 'de') {\n                alert('Bitte füllen Sie alle Felder korrekt aus und stellen Sie sicher, dass das Startdatum vor dem Enddatum liegt.');\n            } else {\n                alert('Please fill in all fields correctly and ensure the start date is before the end date.');\n            }\n        }\n    });\n    \n    // Function to validate the inputs\n    function validateInput(fuel, amount, start, end) {\n        if (!fuel || !amount || !start || !end) {\n            return false;\n        }\n        if (new Date(start) >= new Date(end)) {\n            return false;\n        }\n        return true;\n    }\n</script>\n</body>\n</html>\n",

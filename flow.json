    {
        "id": "6af2607ed7631321",
        "type": "function",
        "z": "e48ca2e6e4e7cd76",
        "name": "Calculate recived Data",
        "func": "// Get the dataCache\nlet dataCache = flow.get(\"DataCache\")\nlet stat = flow.get(\"ConStatus\")\n\n// Group Data\nlet groupedData = dataCache.reduce((result, entry) => {\n    if (entry[0].tags) {\n        let device = entry[0].tags.device\n        if (!result[device]) {\n            result[device] = 0;\n        }\n        result[device]++;\n    }\n    return result;\n}, {});\n\n// Array im msg.payload\nlet array = msg.payload\nlet dataTrue = 0\nlet dataComplete = false\n\n// Über das Array iterieren _value-Wert prüfen\nfor (let i = 0; i < array.length; i++) {\n  let value = array[i]._value\n  let device = array[i].tags_device\n  let sentData = groupedData[device]\n  if (sentData === value || sentData === (value+1)) {\n    dataTrue++\n  } else{\n      \n  }\n}\n\nif(dataTrue === array.length){\n    dataComplete = true\n}else{\n    dataComplete = false\n}\n\nif (dataComplete) {\n    node.status({fill:\"green\",shape:\"dot\",text:\"All data received\"})\n} else {\n    node.status({fill:\"red\",shape:\"dot\",text:\"Data missing\"})\n    if (stat === \"Connected\" || stat === \"Sending message\"){\n        for (let item of dataCache) {\n            node.send({ payload: item });\n        }\n    }\n}",

        "func": "let measurement = \"sensors\";\nlet uid = global.get('uid');\nlet currentTime = new Date();\n\nfunction addsensordata(device, input) {\n  let record = {\n    \"measurement\": measurement,\n    \"timestamp\": currentTime.toISOString(),\n    \"tags\": {\n        \"UID\": uid,\n        \"device\": device,\n        \"model\": \"Pro 3EM\"\n    },\n    \"fields\": {\n      \"a_act_power\": input.a_act_power,\n      \"a_aprt_power\": input.a_aprt_power,\n      \"a_pf\": input.a_pf,\n      \"b_act_power\": input.b_act_power,\n      \"b_aprt_power\": input.b_aprt_power,\n      \"b_pf\": input.b_pf,\n      \"c_act_power\": input.c_act_power,\n      \"c_aprt_power\": input.c_aprt_power,\n      \"c_pf\": input.c_pf,\n    }\n  };\n  return record;\n}\n\nlet data = [];\n\ndata.push(addsensordata(\"Solaremeter\", {\n  \"a_act_power\": msg.payload.em0.a_act_power,\n  \"a_aprt_power\": msg.payload.em0.a_aprt_power,\n  \"a_pf\": msg.payload.em0.a_pf,\n  \"b_act_power\": msg.payload.em0.b_act_power,\n  \"b_aprt_power\": msg.payload.em0.b_aprt_power,\n  \"b_pf\": msg.payload.em0.b_pf,\n  \"c_act_power\": msg.payload.em0.c_act_power,\n  \"c_aprt_power\": msg.payload.em0.c_aprt_power,\n  \"c_pf\": msg.payload.em0.c_pf\n}));\n\nmsg.payload = data;\n\nreturn msg;",

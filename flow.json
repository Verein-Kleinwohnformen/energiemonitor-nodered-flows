        "id": "a6f9c2d5c3e8bd89",
        "type": "function",
        "z": "ab257fb0cc5ba8f5",
        "name": "JSON",
        "func": "let measurement = \"sensors\"\n\nfunction addsensordata(device, value){\n    let record = {\n        \"measurement\": measurement,\n        \"tags\":{\n            \"device\": device\n        },\n        \"fields\": {\n            \"stationtype\": value.stationtype,\n            \"dateutc\": value.dateutc,\n            \"tempinf\": value.tempinf,\n            \"humidityin\": value.humidityin,\n            \"baromrelin\": value.baromrelin,\n            \"baromabsin\": value.baromabsin,\n            \"tempf\": value.tempf,\n            \"humidity\": value.humidity,\n            \"winddir\": value.winddir,\n            \"winddir_avg10m\": value.winddir_avg10m,\n            \"windspeedmph\": value.windspeedmph,\n            \"maxdailygust\": value.maxdailygust,\n            \"rainratein\": value.rainratein,\n            \"eventrainin\": value.eventrainin,\n            \"hourlyrainin\": value.hourlyrainin,\n            \"dailyrainin\": value.dailyrainin,\n            \"weeklyrainin\": value.weeklyrainin,\n            \"monthlyrainin\": value.monthlyrainin,\n            \"yearlyrainin\": value.yearlyrainin,\n            \"solarradiation\": value.solarradiation,\n            \"uv\": value.uv,\n            \"model\": value.model,\n        }\n    };\n    return record;\n}\n\nlet data = [];\n\ndata.push(addsensordata(\"weatherstation\", msg.payload));\n\nmsg.payload = data\n\nreturn msg;",

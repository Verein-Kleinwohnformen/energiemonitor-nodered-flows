    {
        "id": "f871afd17d33fea9",
        "type": "function",
        "z": "e48ca2e6e4e7cd76",
        "name": "DataCache",
        "func": "// Holen Sie die bisher gespeicherten Daten (oder initialisieren Sie auf ein leeres Array, wenn noch nichts gespeichert ist)\nlet data = flow.get(\"DataCache\") || []\nlet stat = flow.get(\"ConStatus\")\nlet cache = flow.get(\"CacheStatus\") || false\n// Filtern Sie Daten, um nur Elemente zu behalten, die jünger als 1 Stunde sind\nif (stat === \"Connected\" || stat === \"Sending message\"){\n    if (cache){\n        for (let item of dataCache) {\n            node.send({ payload: item });\n        }\n        cache = false;\n    }\n    data = data.filter(item => {\n        // Extrahieren Sie das innere Objekt\n        let innerObject = item[0]\n        // Das Datum ist im ISO-Format gespeichert, z.B. \"2023-07-09T15:34:26.868Z\"\n        let itemDate = new Date(innerObject.timestamp)\n        // Zeitdifferenz in Millisekunden\n        let diffMs = Date.now() - itemDate.getTime()\n        // Umwandlung in Stunden\n        let diffHours = diffMs / (1000 * 60 * 60);\n        // Behalten Sie das Element nur, wenn es weniger als 1 Stunde alt ist\n        return diffHours < 1\n    })\n} else {\n    cache = true\n}\n// Fügen Sie das neue Payload zur Liste hinzu\ndata.push(msg.payload)\n\n// Save the updated sent data count\nflow.set(\"DataCache\", data)\nflow.set(\"CacheStatus\", cache)\n\nreturn msg;\n",

    {
        "id": "be41fd6d2844363a",
        "type": "function",
        "z": "a4cd0360ff8bbb01",
        "name": "extract sensor values",
        "func": "var dpsTable = {\n    \"1\": \"temperatur\",\n    \"2\": \"feuchtigkeit\",\n    \"4\": \"batterie\",\n    \"101\": \"innentemperatur\",\n    \"102\":\"innenfeuchtigkeit\",\n    \"103\": \"aussentemperatur\",\n    \"104\": \"aussenfeuchtigkeit\",\n    \"105\": \"aussentemperatur2\",\n    \"106\": \"aussenfeuchtigkeit2\"\n}\n\nvar dpsMultiplier = {\n    \"temperatur\": 0.1,\n    \"innentemperatur\": 0.1,\n    \"innenfeuchtigkeit\": 0.1,\n    \"aussentemperatur\": 0.1,\n    \"aussenfeuchtigkeit\": 0.1,\n    \"aussentemperatur2\": 0.1,\n    \"aussenfeuchtigkeit2\": 0.1\n}\n\nvar dps = Object.keys(msg.payload.data.dps)[0];\n\nif (Object.keys(dpsTable).includes(dps)){\n    var key = dpsTable[dps];\n    var multiplier = 1;\n    if(Object.keys(dpsMultiplier).includes(key)){\n        multiplier = dpsMultiplier[key];\n    }\n    var val = msg.payload.data.dps[dps] * multiplier;\n    var sendKey = key + \"_\" + msg.payload.deviceName;\n    var sendMsg = {\"payload\": {[sendKey]: val}};\n    return sendMsg;\n}\n\nelse {\n    var dpsKey = Object.keys(msg.payload.data.dps);\n    var otherKey = \"tuya_\" + dpsKey + \"_\" + msg.payload.deviceName;\n    var otherData = msg.payload.data.dps[Number(dpsKey)];\n    var oMsg = {\"payload\": {[otherKey]: otherData}};\n    return oMsg;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 420,
        "wires": [
            [
                "3938a2ae6acee187"
            ]
        ]
    },

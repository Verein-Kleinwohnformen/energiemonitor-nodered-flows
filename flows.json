    {
        "id": "626b7da903f41492",
        "type": "function",
        "z": "3e07724de1527d10",
        "name": "Decode Netatmo",
        "func": "var addr = env.get('NETATMO_ADDRESS');\nvar devices = msg.payload.body.devices;\n\nvar data = {};\n\n// Loop through all devices found\nfor (let i = 0; i < devices.length; i++) {\n    if (devices[i]._id == addr){\n        data[\"netatmo_indoor_id\"] = devices[i]._id;\n        var indoor_data = devices[i].dashboard_data;\n\n        data[\"indoor_reachable\"] = devices[i].reachable;\n\n        if (devices[i].reachable) {\n            // Parse indoor data\n            data[\"indoor_signal\"] = devices[i].wifi_status;\n            data[\"indoor_temperature\"] = indoor_data.Temperature;\n            data[\"indoor_humidity\"] = indoor_data.Humidity;\n            data[\"indoor_co2\"] = indoor_data.CO2;\n            data[\"indoor_pressure\"] = indoor_data.Pressure;\n\n            // Loop through outdoor modules\n            var modules = devices[i].modules;\n            for (let j = 0; j < modules.length; j++) {\n                // Read data of the first module only\n                if (j==0) {\n                    data[\"outdoor_reachable\"] = modules[j].reachable;\n\n                    if (modules[j].reachable) { \n                    data[\"netatmo_outdoor_id\"] = modules[j]._id;\n                    var outdoor_data = modules[j].dashboard_data;\n                    data[\"outdoor_temperature\"] = outdoor_data.Temperature;\n                    data[\"outdoor_humidity\"] = outdoor_data.Humidity;\n                    data[\"outdoor_battery\"] = modules[j].battery_percent;\n                    data[\"outdoor_signal\"] = modules[j].rf_status;\n                    \n                    // Calculate temperature difference signal\n                    data[\"temperature_difference\"] = indoor_data.Temperature - outdoor_data.Temperature;\n                    }\n                }\n                if (j>0){\n                    data[\"warning\"] = \"Multiple outdoor stations found\";\n                }\n            }\n        }\n      }\n    }\n\nmsg.payload = data;\nmsg.topic = 'netatmo';\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 710,
        "y": 280,
        "wires": [
            [
                "78dea314d74e558e",
                "ec657adab09717c5"
            ]
        ]
    },

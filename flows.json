    {
        "id": "b0e1e00000000003",
        "type": "function",
        "z": "3e07724de1527d10",
        "name": "Boiler-Werte",
        "func": "// Shelly 1PM Gen4 (Boiler), nur lesen: der GX schaltet den Boiler.\nif (msg.error) return null;\nvar p = msg.payload || {};\nvar sw = p.switch0 || p[\"switch:0\"] || (p.apower !== undefined ? p : null);\nif (!sw || sw.apower === undefined) return null;\nvar v = { act_power: Number(sw.apower) };\nif (sw.voltage != null) v.voltage = Number(sw.voltage);\nif (sw.current != null) v.current = Number(sw.current);\nif (sw.aenergy && sw.aenergy.total != null) v.energy_total_wh = Number(sw.aenergy.total);\nv.relay_on = sw.output ? 1 : 0;\nif (sw.temperature && sw.temperature.tC != null) v.device_temperature = Number(sw.temperature.tC);\nmsg.payload = v;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],

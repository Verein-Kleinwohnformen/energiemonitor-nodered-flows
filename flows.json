        "type": "http request",
        "z": "3e07724de1527d10",
        "name": "Shelly 1PM Gen4 Boiler",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,

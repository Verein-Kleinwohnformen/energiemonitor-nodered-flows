    {
        "id": "f53d48df6c84f842",
        "type": "function",
        "z": "a4cd0360ff8bbb01",
        "name": "Decode DC readings",
        "func": "var modbus = msg.payload\n\nvar dc = {};\n\ndc[\"dc_voltage\"] = modbus[\"PZEM017/VOLTAGE\"];\ndc[\"dc_current\"] = modbus[\"PZEM017/CURRENT\"];\n// Bitshift with a 0.1 multiplier\ndc[\"dc_power\"] = modbus[\"PZEM017/POWER_HIGH\"] * 6553.6 + modbus[\"PZEM017/POWER_LOW\"];\n// Bitshift with a 1 multiplier\ndc[\"dc_energy_counter\"] = modbus[\"PZEM017/ENERGY_HIGH\"] * 65536 + modbus[\"PZEM017/ENERGY_LOW\"];\n\n\nmsg.payload = dc;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1040,

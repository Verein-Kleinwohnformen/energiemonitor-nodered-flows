    {
        "id": "be41fd6d2844363a",
        "type": "function",
        "z": "a4cd0360ff8bbb01",
        "name": "extract sensor values",
        "func": "if (1 in msg.payload.data.dps){\n    var t = msg.payload.data.dps[\"1\"] / 10;\n    var tKey = \"temperatur_\" + msg.payload.deviceName;\n    var tMsg = {\"payload\": {[tKey]: t}};\n    return tMsg;\n}\n\nelse if (2 in msg.payload.data.dps){\n    var h = msg.payload.data.dps[\"2\"];\n    var hKey = \"feuchtigkeit_\" + msg.payload.deviceName;\n    var hMsg = {\"payload\": {[hKey]: h}};\n    return hMsg;\n}\n\nelse if (4 in msg.payload.data.dps){\n    var b = msg.payload.data.dps[\"4\"];\n    var bKey = \"batterie_\" + msg.payload.deviceName;\n    var bMsg = {\"payload\": {[bKey]: b}};\n    return bMsg;\n}\n\nelse {\n    var dpsKey = Object.keys(msg.payload.data.dps);\n    var otherKey = \"tuya_\" + dpsKey + \"_\" + msg.payload.deviceName;\n    var otherData = msg.payload.data.dps[otherKey];\n    var oMsg = {\"payload\": {[otherKey]: otherData}};\n    return oMsg;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 240,
        "wires": [
            [
                "3938a2ae6acee187",
                "1b95392a3a03fee1"
            ]
        ]

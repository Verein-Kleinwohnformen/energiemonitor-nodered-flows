    {
        "id": "e81cfc346de986bd",
        "type": "function",
        "z": "3e07724de1527d10",
        "name": "Decode",
        "func": "var modbus = msg.payload\n\nvar dc = {};\n\ndc[\"voltage\"] = modbus[\"PZEM017/VOLTAGE\"];\ndc[\"current\"] = modbus[\"PZEM017/CURRENT\"];\n// Bitshift with a 0.1 multiplier\ndc[\"power\"] = modbus[\"PZEM017/POWER_HIGH\"] * 6553.6 + modbus[\"PZEM017/POWER_LOW\"];\n// Bitshift with a 1 multiplier\ndc[\"energy_counter\"] = modbus[\"PZEM017/ENERGY_HIGH\"] * 65536 + modbus[\"PZEM017/ENERGY_LOW\"];\n\nmsg.payload = dc;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
